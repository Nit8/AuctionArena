<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Auction Arena</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-auction mb-4">
        <div class="container">
            <a class="navbar-brand-auction" href="/">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
                Auction Arena
            </a>
            @if (Context.Session.TryGetValue("LobbyId", out _) && !(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Auction"))
            {
                <span class="text-white-50" style="font-size:0.8rem">
                    Lobby: <strong class="text-white">@Context.Session.GetString("LobbyId")</strong>
                </span>
            }
        </div>
    </nav>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <div id="connectionStatus" class="connection-status connected">
        <span style="width:8px;height:8px;border-radius:50%;background:currentColor"></span> Connected
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script src="~/js/connection.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
