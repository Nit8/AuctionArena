@model AuctionArena.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container">
    <div class="card-auction">
        <div class="card-body-auction p-4 text-center">
            <h1 style="font-weight:800;color:var(--danger)">Error</h1>
            <p style="color:var(--gray-500)">An error occurred while processing your request.</p>
            @if (Model.ShowRequestId)
            {
                <p><small class="text-muted">Request ID: @Model.RequestId</small></p>
            }
            <a href="/" class="btn-auction btn-primary-auction mt-3">Go Home</a>
        </div>
    </div>
</div>
