@{
    ViewData["Title"] = "Home";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center text-white mb-5">
                <h1 style="font-size:3rem;font-weight:900;margin-bottom:0.5rem">Auction Arena</h1>
                <p class="lead" style="opacity:0.85">Real-time player auction for sports teams</p>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card-auction h-100" style="cursor:pointer" onclick="location.href='/Auction/CreateLobby'">
                        <div class="card-body-auction text-center p-5">
                            <div style="width:4rem;height:4rem;border-radius:1rem;background:var(--gradient-primary);display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                                    <path d="M12 5v14M5 12h14"/>
                                </svg>
                            </div>
                            <h4 style="font-weight:700;margin-bottom:0.75rem">Host Auction</h4>
                            <p style="color:var(--gray-500);margin-bottom:1.5rem">Create a new lobby and invite team owners to participate in your auction</p>
                            <button class="btn-auction btn-primary-auction btn-lg-auction w-100">Create Lobby</button>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card-auction h-100" style="cursor:pointer" onclick="location.href='/Auction/JoinLobby'">
                        <div class="card-body-auction text-center p-5">
                            <div style="width:4rem;height:4rem;border-radius:1rem;background:linear-gradient(135deg,#059669,#10b981);display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                                </svg>
                            </div>
                            <h4 style="font-weight:700;margin-bottom:0.75rem">Join Auction</h4>
                            <p style="color:var(--gray-500);margin-bottom:1.5rem">Enter a lobby code and join as a team owner to bid on players</p>
                            <button class="btn-auction btn-success-auction btn-lg-auction w-100">Join Lobby</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-auction mt-5">
                <div class="card-body-auction p-4">
                    <h5 style="font-weight:700;margin-bottom:1rem">How It Works</h5>
                    <div class="row g-3">
                        <div class="col-md-4 d-flex align-items-start gap-3">
                            <div style="min-width:2rem;height:2rem;border-radius:50%;background:var(--gradient-primary);color:white;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem">1</div>
                            <div><strong>Host creates a lobby</strong><br><small class="text-muted">Set up teams, points, and add players</small></div>
                        </div>
                        <div class="col-md-4 d-flex align-items-start gap-3">
                            <div style="min-width:2rem;height:2rem;border-radius:50%;background:var(--gradient-primary);color:white;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem">2</div>
                            <div><strong>Team owners join</strong><br><small class="text-muted">Use lobby code and password to join</small></div>
                        </div>
                        <div class="col-md-4 d-flex align-items-start gap-3">
                            <div style="min-width:2rem;height:2rem;border-radius:50%;background:var(--gradient-primary);color:white;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem">3</div>
                            <div><strong>Real-time bidding</strong><br><small class="text-muted">Owners bid with their points budget</small></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
