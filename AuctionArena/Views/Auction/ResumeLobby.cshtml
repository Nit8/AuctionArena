@model AuctionArena.Models.ResumeLobbyViewModel
@{
    ViewData["Title"] = "Resume Auction";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="text-center text-white mb-5">
                <div style="width:5rem;height:5rem;border-radius:1.25rem;background:linear-gradient(135deg,#d97706,#f59e0b);display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                        <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                </div>
                <h1 style="font-size:2.5rem;font-weight:900;margin-bottom:0.5rem">Resume Auction</h1>
                <p class="lead" style="opacity:0.85">Reconnect to your lobby as the host and continue where you left off</p>
            </div>

            <div class="card-auction">
                <div class="card-body-auction p-4">
                    <form asp-action="ResumeLobby" method="post">
                        <div asp-validation-summary="ModelOnly" class="global-error"></div>

                        <div class="mb-4">
                            <label asp-for="LobbyId" class="form-label" style="font-weight:600;color:var(--gray-700)">Lobby Code</label>
                            <input asp-for="LobbyId" class="form-control-auction form-control-lg-auction"
                                   placeholder="Enter your lobby code"
                                   style="text-align:center;font-size:1.5rem;letter-spacing:3px;text-transform:uppercase"
                                   autocomplete="off" />
                            <small class="text-muted">The lobby code you received when creating the auction</small>
                            <span asp-validation-for="LobbyId" class="field-error"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label" style="font-weight:600;color:var(--gray-700)">Lobby Password</label>
                            <input asp-for="Password" type="password" class="form-control-auction form-control-lg-auction"
                                   placeholder="Enter lobby password"
                                   style="text-align:center;font-size:1.25rem"
                                   autocomplete="current-password" required />
                            <small class="text-muted">The password you set when creating the lobby</small>
                            <span asp-validation-for="Password" class="field-error"></span>
                        </div>

                        <button type="submit" class="btn-auction btn-warning-auction btn-lg-auction w-100" style="font-size:1.1rem">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:0.5rem">
                                <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                            </svg>
                            Resume Auction
                        </button>
                    </form>
                </div>
            </div>

            <div class="card-auction mt-4">
                <div class="card-body-auction">
                    <h6 style="font-weight:700;margin-bottom:0.75rem">Need Help?</h6>
                    <ul class="mb-0" style="font-size:0.875rem;color:var(--gray-500)">
                        <li class="mb-1">The lobby code was shown when you first created the auction</li>
                        <li class="mb-1">Only password-protected lobbies can be resumed</li>
                        <li>You can resume both active and completed auctions</li>
                    </ul>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/" style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:0.875rem">
                    Back to Home
                </a>
            </div>
        </div>
    </div>
</div>
