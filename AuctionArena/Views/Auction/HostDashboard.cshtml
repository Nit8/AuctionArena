@model AuctionArena.Models.AuctionViewModel
@{
    ViewData["Title"] = "Host Dashboard";
}

<div class="container-fluid">
    @Html.AntiForgeryToken()
    <input type="hidden" data-current-player-id="@(Model.CurrentPlayer?.PlayerId ?? 0)" />

    <!-- Header -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card-auction-dark p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h2 style="margin:0;font-weight:800;font-size:1.5rem">@Model.Lobby.GameName Auction</h2>
                        <p style="margin:0;opacity:0.7">Lobby Code: <strong style="letter-spacing:3px">@Model.Lobby.LobbyId</strong></p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/Auction/ManagePlayers/@Model.Lobby.LobbyId" class="btn-auction btn-ghost btn-sm-auction">Manage Players</a>
                        <button class="btn-auction @(Model.IsPaused ? "btn-success-auction" : "btn-warning-auction") btn-sm-auction" id="pauseBtn" onclick="togglePause()">
                            @(Model.IsPaused ? "Resume" : "Pause")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Current Auction Panel -->
        <div class="col-lg-8">
            <div class="card-auction mb-3">
                <div class="card-header-auction card-header-primary">
                    <span>Current Auction</span>
                    <div id="countdownTimer" class="countdown-timer"></div>
                </div>
                <div class="card-body-auction" id="currentAuctionPanel">
                    @if (Model.CurrentPlayer != null)
                    {
                        <div class="text-center p-4">
                            <h1 style="font-size:2.5rem;font-weight:800;margin-bottom:0.5rem">@Model.CurrentPlayer.PlayerName</h1>
                            <h4 style="color:var(--gray-500);margin-bottom:1.5rem">@Model.CurrentPlayer.Position</h4>
                            <div class="bid-display" id="bidDisplay">
                                @if (Model.CurrentHighestBid.HasValue)
                                {
                                    <div class="bid-amount">@Model.CurrentHighestBid</div>
                                    <div class="bid-team">by @Model.CurrentHighestBidder?.TeamName</div>
                                }
                                else
                                {
                                    <h3 style="color:var(--gray-400);font-weight:600">Waiting for bids...</h3>
                                }
                            </div>
                            <div class="d-grid gap-2 mt-4" style="max-width:400px;margin:1.5rem auto 0">
                                <button id="confirmSaleBtn" class="btn-auction btn-success-auction btn-lg-auction" onclick="confirmSale()"
                                        @(!Model.CurrentHighestBid.HasValue ? "disabled" : "")>
                                    Confirm Sale
                                </button>
                                <button class="btn-auction btn-danger-auction" onclick="skipPlayer()">
                                    Skip Player
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-5">
                            <svg style="width:4rem;height:4rem;color:var(--gray-400);margin-bottom:1rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <h4 style="color:var(--gray-400)">No player in auction</h4>
                            <p style="color:var(--gray-400)">Select a player from the list to start bidding</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Bid History -->
            <div class="card-auction mb-3">
                <div class="card-header-auction">
                    <span style="font-weight:700">Bid History</span>
                </div>
                <div class="card-body-auction p-2">
                    <div id="bidHistoryList" class="scroll-list" style="max-height:200px">
                        @foreach (var bid in Model.CurrentBids.OrderByDescending(b => b.BidAmount))
                        {
                            <div class="bid-history-item @((Model.CurrentHighestBidder?.TeamId == bid.TeamId) ? "highest" : "")">
                                <span style="font-weight:600">@Model.Teams.FirstOrDefault(t => t.TeamId == bid.TeamId)?.TeamName</span>
                                <span class="badge-auction badge-primary">@bid.BidAmount pts</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Teams Overview -->
            <div class="card-auction">
                <div class="card-header-auction">
                    <span style="font-weight:700">Teams Overview</span>
                </div>
                <div class="card-body-auction">
                    <div class="row g-3" id="teamsDisplay">
                        @foreach (var team in Model.Teams)
                        {
                            <div class="col-md-6" data-team-id="@team.TeamId">
                                <div class="team-card-auction">
                                    <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:0.75rem">
                                        <div>
                                            <h6 style="font-weight:700;margin:0">@team.TeamName</h6>
                                            <small style="color:var(--gray-500)">Owner: @team.OwnerName</small>
                                        </div>
                                        <button class="btn-auction btn-primary-auction btn-sm-auction" onclick="addPoints(@team.TeamId, '@team.TeamName')">
                                            Add Points
                                        </button>
                                    </div>
                                    <div style="display:flex;gap:0.5rem">
                                        <span class="badge-auction badge-info team-player-count">@team.PlayerCount Players</span>
                                        <span class="badge-auction badge-success team-points">@team.RemainingPoints Points</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Players List -->
        <div class="col-lg-4">
            <div class="card-auction mb-3">
                <div class="card-header-auction card-header-success">
                    <span style="font-weight:700">Available Players</span>
                    <span class="badge-aunction badge-primary" id="availableCount">@Model.RemainingPlayers.Count</span>
                </div>
                <div class="card-body-auction p-2 scroll-list">
                    @foreach (var player in Model.RemainingPlayers)
                    {
                        <div class="player-card-auction" data-player-id="@player.PlayerId">
                            <div style="display:flex;justify-content:space-between;align-items:center">
                                <div>
                                    <strong style="font-size:0.9rem">@player.PlayerName</strong><br>
                                    <small style="color:var(--gray-500)">@player.Position</small>
                                </div>
                                <button class="btn-auction btn-primary-auction btn-sm-auction" onclick="startAuction(@player.PlayerId)">
                                    Start
                                </button>
                            </div>
                        </div>
                    }
                    @if (!Model.RemainingPlayers.Any())
                    {
                        <p class="text-center text-muted p-3 mb-0">No available players</p>
                    }
                </div>
            </div>

            <div class="card-auction">
                <div class="card-header-auction card-header-info">
                    <span style="font-weight:700">Sold Players</span>
                    <span class="badge-auction badge-success" id="soldCount">@Model.SoldPlayers.Count</span>
                </div>
                <div class="card-body-auction p-2 scroll-list" style="max-height:300px" id="soldPlayersList">
                    @foreach (var player in Model.SoldPlayers)
                    {
                        <div class="player-card-auction sold">
                            <div style="display:flex;justify-content:space-between;align-items:center">
                                <div>
                                    <strong style="font-size:0.9rem">@player.PlayerName</strong><br>
                                    <small style="color:var(--gray-500)">@player.Position</small>
                                </div>
                                <span class="badge-auction badge-success">@(player.SoldPrice) pts</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/hostDashboard.js"></script>
<script>
    const lobbyId = '@Model.Lobby.LobbyId';
    initHostDashboard(lobbyId);
</script>
}
