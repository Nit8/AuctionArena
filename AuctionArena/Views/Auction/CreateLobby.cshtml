@model AuctionArena.Models.CreateLobbyViewModel
@{
    ViewData["Title"] = "Create Lobby";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card-auction">
                <div class="card-header-auction card-header-primary">
                    <h4 style="margin:0;font-weight:700">Create Auction Lobby</h4>
                </div>
                <div class="card-body-auction p-4">
                    <form method="post" id="createLobbyForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="global-error" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Your Name (Host)</label>
                                <input type="text" class="form-control-auction" asp-for="HostName" required>
                                <span asp-validation-for="HostName" class="field-error"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Game/Sport Name</label>
                                <input type="text" class="form-control-auction" asp-for="GameName" placeholder="e.g., Football, Cricket" required>
                                <span asp-validation-for="GameName" class="field-error"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Lobby Password (Optional)</label>
                            <input type="password" class="form-control-auction" asp-for="Password" placeholder="Leave empty for no password">
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Number of Teams</label>
                                <input type="number" class="form-control-auction" asp-for="TotalTeams" id="totalTeams" value="4" min="2" max="12" required>
                                <span asp-validation-for="TotalTeams" class="field-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Points per Team</label>
                                <input type="number" class="form-control-auction" asp-for="PointsPerTeam" value="1000" min="100" required>
                                <span asp-validation-for="PointsPerTeam" class="field-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Players per Team</label>
                                <input type="number" class="form-control-auction" asp-for="PlayersPerTeam" value="11" min="1" required>
                                <span asp-validation-for="PlayersPerTeam" class="field-error"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Min Players per Team</label>
                                <input type="number" class="form-control-auction" asp-for="MinPlayersPerTeam" value="8" min="1" required>
                                <span asp-validation-for="MinPlayersPerTeam" class="field-error"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Max Players per Team</label>
                                <input type="number" class="form-control-auction" asp-for="MaxPlayersPerTeam" value="15" min="1" required>
                                <span asp-validation-for="MaxPlayersPerTeam" class="field-error"></span>
                            </div>
                        </div>

                        <hr style="border-color:var(--gray-200)">
                        <h5 style="font-weight:700;margin-bottom:1rem">Team Setup</h5>
                        <div id="teamsContainer"></div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn-auction btn-primary-auction btn-lg-auction">Create Lobby</button>
                            <a href="/" class="btn-auction btn-outline-auction">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('totalTeams').addEventListener('change', function() {
        generateTeamInputs(this.value);
    });

    function generateTeamInputs(count) {
        const container = document.getElementById('teamsContainer');
        container.innerHTML = '';
        const colors = ['#6366f1','#8b5cf6','#ec4899','#f59e0b','#10b981','#3b82f6','#ef4444','#06b6d4','#84cc16','#f97316','#14b8a6','#a855f7'];
        for (let i = 0; i < count; i++) {
            const color = colors[i % colors.length];
            const teamDiv = document.createElement('div');
            teamDiv.className = 'card-auction mb-3';
            teamDiv.innerHTML = `
                <div class="card-body-auction">
                    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem">
                        <div style="width:1.5rem;height:1.5rem;border-radius:50%;background:${color}"></div>
                        <h6 style="margin:0;font-weight:700">Team ${i + 1}</h6>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <input type="text" class="form-control-auction" name="Teams[${i}].TeamName" placeholder="Team Name" required>
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control-auction" name="Teams[${i}].OwnerName" placeholder="Owner Name" required>
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control-auction" name="Teams[${i}].CaptainName" placeholder="Captain (Optional)">
                        </div>
                    </div>
                </div>
            `;
            container.appendChild(teamDiv);
        }
    }
    generateTeamInputs(4);
</script>
}
