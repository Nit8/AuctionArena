@model List<AuctionArena.Models.Player>
@{
    ViewData["Title"] = "Manage Players";
    var lobbyId = ViewBag.LobbyId;
}

<div class="container">
    @Html.AntiForgeryToken()
    <div class="card-auction mb-4">
        <div class="card-header-auction card-header-primary">
            <h4 style="margin:0;font-weight:700">Manage Players</h4>
            <a href="/Auction/HostDashboard/@lobbyId" class="btn-auction btn-ghost btn-sm-auction">Go to Auction</a>
        </div>
        <div class="card-body-auction">
            <div class="row g-4">
                <div class="col-md-6">
                    <h6 style="font-weight:700;margin-bottom:1rem">Add Single Player</h6>
                    <form method="post" action="/Auction/AddPlayer">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="lobbyId" value="@lobbyId">
                        <div class="row g-2 mb-2">
                            <div class="col-7">
                                <input type="text" class="form-control-auction" name="playerName" placeholder="Player Name" required>
                            </div>
                            <div class="col-3">
                                <input type="text" class="form-control-auction" name="position" placeholder="Position" required>
                            </div>
                            <div class="col-2">
                                <button type="submit" class="btn-auction btn-success-auction w-100">Add</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="col-md-6">
                    <h6 style="font-weight:700;margin-bottom:1rem">Import Multiple Players</h6>
                    <form method="post" action="/Auction/ImportPlayers">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="lobbyId" value="@lobbyId">
                        <div class="mb-2">
                            <textarea class="form-control-auction" name="playersData" rows="3"
                                      placeholder="Format: Name,Position&#10;Example:&#10;Cristiano Ronaldo,Forward&#10;Lionel Messi,Forward"></textarea>
                        </div>
                        <button type="submit" class="btn-auction btn-primary-auction">Import Players</button>
                    </form>
                </div>
            </div>

            @if (TempData["Message"] != null)
            {
                <div class="mt-3" style="background:var(--success-light);padding:0.75rem 1rem;border-radius:var(--radius);color:#065f46;font-weight:500">
                    @TempData["Message"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="mt-3" style="background:var(--danger-light);padding:0.75rem 1rem;border-radius:var(--radius);color:#991b1b;font-weight:500">
                    @TempData["Error"]
                </div>
            }
        </div>
    </div>

    <div class="card-auction">
        <div class="card-header-auction">
            <h6 style="margin:0;font-weight:700">Player List (@Model.Count players)</h6>
        </div>
        <div class="card-body-auction">
            @if (Model.Count == 0)
            {
                <div style="text-align:center;padding:2rem;color:var(--gray-400)">
                    No players added yet. Add players using the forms above.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table" style="margin:0">
                        <thead>
                            <tr style="background:var(--gray-50)">
                                <th style="font-weight:700;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--gray-500)">#</th>
                                <th style="font-weight:700;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--gray-500)">Player Name</th>
                                <th style="font-weight:700;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--gray-500)">Position</th>
                                <th style="font-weight:700;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--gray-500)">Status</th>
                                <th style="font-weight:700;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--gray-500)">Price</th>
                                <th style="font-weight:700;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--gray-500)">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in Model)
                            {
                                <tr>
                                    <td style="color:var(--gray-400)">@player.DisplayOrder</td>
                                    <td><strong>@player.PlayerName</strong></td>
                                    <td style="color:var(--gray-600)">@player.Position</td>
                                    <td>
                                        @if (player.IsAuctioned)
                                        {
                                            <span class="badge-auction badge-success">Sold</span>
                                        }
                                        else
                                        {
                                            <span class="badge-auction badge-warning">Pending</span>
                                        }
                                    </td>
                                    <td>@(player.SoldPrice?.ToString() ?? "-")</td>
                                    <td>
                                        @if (!player.IsAuctioned)
                                        {
                                            <button class="btn-auction btn-danger-auction btn-sm-auction" onclick="deletePlayer(@player.PlayerId)">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function deletePlayer(playerId) {
        if (!confirm('Are you sure you want to delete this player?')) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const formData = new URLSearchParams();
        formData.append('__RequestVerificationToken', token);
        formData.append('lobbyId', '@lobbyId');
        formData.append('playerId', playerId);

        try {
            const response = await fetch('/Auction/DeletePlayer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData.toString()
            });
            const result = await response.json();
            if (result.success) {
                location.reload();
            } else {
                alert(result.message || 'Failed to delete player');
            }
        } catch (err) {
            alert('Error deleting player');
        }
    }
</script>
}
